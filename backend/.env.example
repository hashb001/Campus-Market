# --- Required ---
# MongoDB connection string (e.g. a free MongoDB Atlas cluster)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/campus-market

# Long random string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# --- Optional ---
PORT=5000
# Set to "production" when deployed (enables secure cookies)
NODE_ENV=development

# Only emails on this domain can register (default: northsouth.edu)
ALLOWED_EMAIL_DOMAIN=northsouth.edu

# Comma-separated emails that get admin rights (inbox + remove any listing)
ADMIN_EMAILS=

# --- Sending verification emails (pick one) ---
# Option 1: Brevo (recommended on Render's free plan, which blocks SMTP).
# Free at brevo.com: verify your sender address, then create an API key.
# MAIL_FROM below must be that verified sender.
BREVO_API_KEY=

# Option 2: SMTP. If neither option is set, codes are printed
# to the server console instead (handy for local development).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Campus Market <no-reply@example.com>"

# Only needed if the frontend is hosted on a different domain than the backend
CLIENT_ORIGIN=
